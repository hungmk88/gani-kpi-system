{
  "name": "gani-kpi-system",
  "version": "1.0.0",
  "private": true,
  "description": "GANI FOODY - Work & KPI Management System (Phase 1 MVP Core)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/guard-local-db.mjs && prisma migrate reset --force --skip-seed && node prisma/seed.mjs",
    "scheduler": "node scripts/scheduler.mjs",
    "setup": "prisma generate && prisma migrate deploy && node prisma/seed.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:phase2": "node scripts/smoke-test-phase2.mjs",
    "test:all": "node scripts/smoke-test.mjs && node scripts/smoke-test-phase2.mjs && node scripts/smoke-test-phase3.mjs && node scripts/smoke-test-production.mjs && node scripts/smoke-test-phase4.mjs && node scripts/smoke-test-operations.mjs && node scripts/smoke-test-dashboard.mjs",
    "test:phase3": "node scripts/smoke-test-phase3.mjs",
    "test:production": "node scripts/smoke-test-production.mjs",
    "test:phase4": "node scripts/smoke-test-phase4.mjs",
    "backup": "node scripts/backup.mjs",
    "test:ops": "node scripts/smoke-test-operations.mjs",
    "test:dashboard": "node scripts/smoke-test-dashboard.mjs",
    "test": "vitest run",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Ho_Chi_Minh vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "fix:dates": "node scripts/fix-dates.mjs",
    "db:validate-checks": "node scripts/validate-db-checks.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.46.0",
    "next": "^15.1.3",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
