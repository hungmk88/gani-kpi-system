# ==========================================================
# GANI FOODY - WORK & KPI MANAGEMENT SYSTEM
# Copy file nay thanh .env roi dien gia tri that
# ==========================================================

# --- DATABASE (PostgreSQL / Supabase - bat buoc, khong con SQLite) ---
# May dev dung project Supabase RIENG, dung tro vao database production.
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"  # pooler, app dung
DIRECT_URL="postgresql://user:pass@host:5432/db"                    # truc tiep, chi Prisma Migrate dung
#
# QUAN TRONG neu dung Supabase: pooler (cong 6543) BAT BUOC co "?pgbouncer=true"
# o cuoi, khong thi Prisma bao loi "prepared statement already exists". DIRECT_URL
# (cong 5432) thi KHONG them cai nay. Ca hai bien phai co mat thi migrate moi chay
# duoc (xem schema.prisma: datasource co ca url va directUrl).

# --- BAO MAT ---
# Chuoi bi mat de ky JWT. BAT BUOC tu tao, toi thieu 32 ky tu. He thong TU CHOI
# chay neu de trong, qua ngan, hoac con chuoi mau "doi-chuoi-...".
# Tao chuoi ngau nhien: openssl rand -hex 48
JWT_SECRET="doi-chuoi-nay-truoc-khi-len-production"
# Thoi han token dang nhap
JWT_EXPIRES_IN="12h"

# --- TELEGRAM ALERT ENGINE ---
# Lay token tu @BotFather tren Telegram
TELEGRAM_BOT_TOKEN=""
# Chat ID cua CEO / nhom Ban Giam doc (nhan canh bao do)
CEO_TELEGRAM_CHAT_ID=""
# Bat/tat toan bo canh bao Telegram (true/false)
TELEGRAM_ENABLED="false"

# --- TELEGRAM BOT TUONG TAC (PHASE 3) ---
# Khoa bi mat Telegram phai gui kem moi lan goi webhook.
# Khai luc goi setWebhook. THIEU KHOA NAY THI KHONG BAT WEBHOOK - vi khong co no
# thi ai cung tu che duoc goi tin "CEO vua bam duyet".
TELEGRAM_WEBHOOK_SECRET=""
# Ten bot (khong co dau @) - dung de dung link noi nhanh cho nhan vien
TELEGRAM_BOT_USERNAME=""

# --- ZALO ZNS (PHASE 3) ---
# Zalo chi gui duoc theo mau da duoc Zalo duyet truoc, khong gui tu do.
ZALO_ENABLED="false"
ZALO_ZNS_ACCESS_TOKEN=""
ZALO_TEMPLATE_KPI_REMINDER=""
ZALO_TEMPLATE_TASK_CRITICAL=""
ZALO_TEMPLATE_KPI_LOCKED=""

# --- CRON / SCHEDULER ---
# Secret de goi endpoint cron tu ben ngoai (cron-job.org), gui trong header
# x-cron-secret (KHONG dat tren URL). Toi thieu 16 ky tu; chuoi mau bi tu choi.
CRON_SECRET="doi-chuoi-cron-nay-di"

# --- TICH HOP iPOS / ERP (Phase 3) ---
# Secret ma iPOS phai gui kem trong header X-Webhook-Secret (duong cu, chi dung
# khi CHUA dang ky nguon "ipos" HMAC trong Quan tri -> Tich hop). Toi thieu 16 ky
# tu; chuoi mau bi tu choi.
IPOS_WEBHOOK_SECRET="doi-chuoi-webhook-nay-di"

# --- TICH HOP MISA ASP (muc 1 Phan B, 10/09/2026 - CHUA XONG) ---
# Khung goi da dung o lib/integrations/misa-client.ts, CHUA TEST vi chua co
# app_id/access_code that. Dien vao khi ben ky thuat MISA mo API xong.
MISA_APP_ID=""
MISA_ACCESS_CODE=""
MISA_ORG_COMPANY_CODE=""
MISA_API_URL="https://actapp.misa.vn"

# --- AI (Phase 2) ---
# Lay khoa mien phi tai https://aistudio.google.com/apikey
# De trong thi he thong van chay: bo doc luat cung se thay AI lam viec,
# chi kem linh hoat hon chu khong hong tinh nang nao.
GEMINI_API_KEY=""
# Model dung de goi. Doi duoc neu Google ra ban moi.
GEMINI_MODEL="gemini-2.0-flash"

# --- URL he thong (dung trong link canh bao Telegram) ---
APP_URL="http://localhost:3000"
