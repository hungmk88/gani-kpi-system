# ==========================================================
# GANI FOODY - WORK & KPI MANAGEMENT SYSTEM
# Copy file nay thanh .env roi dien gia tri that
# ==========================================================

# --- DATABASE ---
# SQLite (mac dinh, chay ngay tren may, khong can cai gi)
DATABASE_URL="file:./dev.db"
# Khi len production doi sang PostgreSQL (Supabase / VPS):
# DATABASE_URL="postgresql://user:password@host:5432/kpidb?schema=public"

# --- BAO MAT ---
# Chuoi bi mat de ky JWT. BAT BUOC doi truoc khi dua len production.
# Tao chuoi ngau nhien: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi-chuoi-nay-truoc-khi-len-production-1234567890abcdef"
# Thoi han token dang nhap
JWT_EXPIRES_IN="12h"

# --- TELEGRAM ALERT ENGINE ---
# Lay token tu @BotFather tren Telegram
TELEGRAM_BOT_TOKEN=""
# Chat ID cua CEO / nhom Ban Giam doc (nhan canh bao do)
CEO_TELEGRAM_CHAT_ID=""
# Bat/tat toan bo canh bao Telegram (true/false)
TELEGRAM_ENABLED="false"

# --- TELEGRAM BOT TUONG TAC (PHASE 3) ---
# Khoa bi mat Telegram phai gui kem moi lan goi webhook.
# Khai luc goi setWebhook. THIEU KHOA NAY THI KHONG BAT WEBHOOK - vi khong co no
# thi ai cung tu che duoc goi tin "CEO vua bam duyet".
TELEGRAM_WEBHOOK_SECRET=""
# Ten bot (khong co dau @) - dung de dung link noi nhanh cho nhan vien
TELEGRAM_BOT_USERNAME=""

# --- ZALO ZNS (PHASE 3) ---
# Zalo chi gui duoc theo mau da duoc Zalo duyet truoc, khong gui tu do.
ZALO_ENABLED="false"
ZALO_ZNS_ACCESS_TOKEN=""
ZALO_TEMPLATE_KPI_REMINDER=""
ZALO_TEMPLATE_TASK_CRITICAL=""
ZALO_TEMPLATE_KPI_LOCKED=""

# --- CRON / SCHEDULER ---
# Secret de goi endpoint cron tu ben ngoai (Task Scheduler, cron-job.org)
CRON_SECRET="doi-chuoi-cron-nay-di"

# --- TICH HOP iPOS / ERP (Phase 3) ---
# Secret ma iPOS phai gui kem trong header X-Webhook-Secret
IPOS_WEBHOOK_SECRET="doi-chuoi-webhook-nay-di"

# --- AI (Phase 2) ---
# Lay khoa mien phi tai https://aistudio.google.com/apikey
# De trong thi he thong van chay: bo doc luat cung se thay AI lam viec,
# chi kem linh hoat hon chu khong hong tinh nang nao.
GEMINI_API_KEY=""
# Model dung de goi. Doi duoc neu Google ra ban moi.
GEMINI_MODEL="gemini-2.0-flash"

# --- URL he thong (dung trong link canh bao Telegram) ---
APP_URL="http://localhost:3000"
